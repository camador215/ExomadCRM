  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Shared Data as Object

Public Function GetData(Num as Integer) as Object
  Return Cstr(Choose(Num, Split(Cstr(Data),Chr(177))))
End Function

Public Function SetData(NewData as Object)
  Data = NewData
  Return True
End Function

Public Function NumberToWords(ByVal value As Decimal) As String

    Dim whole As Long = Math.Floor(value)
    Dim cents As Integer = CInt(Math.Round((value - whole) * 100))

    Dim result As String = ConvertWholeNumber(whole)

    result = result &amp; " " &amp; cents.ToString("00") &amp; "/100 United States Dollars"

    Return result.Trim()

End Function


Private Function ConvertWholeNumber(ByVal number As Long) As String

    If number = 0 Then
        Return "Zero"
    End If

    Dim result As String = ""

    ' Billions
    If number &gt;= 1000000000 Then
        result = result &amp; ConvertWholeNumber(number \ 1000000000) &amp; " Billion"
        number = number Mod 1000000000

        If number &gt; 0 Then
            result = result &amp; " "
        End If
    End If

    ' Millions
    If number &gt;= 1000000 Then
        result = result &amp; ConvertWholeNumber(number \ 1000000) &amp; " Million"
        number = number Mod 1000000

        If number &gt; 0 Then
            result = result &amp; " "
        End If
    End If

    ' Thousands
    If number &gt;= 1000 Then
        result = result &amp; ConvertWholeNumber(number \ 1000) &amp; " Thousand"
        number = number Mod 1000

        If number &gt; 0 Then
            result = result &amp; " "
        End If
    End If

    ' Hundreds
    If number &gt;= 100 Then

        result = result &amp; ConvertBelowThousand(number \ 100)
        result = result &amp; " Hundred"

        number = number Mod 100

        If number &gt; 0 Then
            result = result &amp; " and "
        End If

    ElseIf number &gt; 0 And result &lt;&gt; "" Then

        ' British/financial style:
        ' Thousand and Twenty
        ' Million and Five Hundred
        result = result &amp; "and "

    End If

    If number &gt; 0 Then
        result = result &amp; ConvertBelowHundred(number)
    End If

    Return result.Trim()

End Function


Private Function ConvertBelowThousand(ByVal number As Long) As String

    If number = 0 Then
        Return ""
    End If

    If number &gt;= 100 Then
        Return ConvertBelowHundred(number \ 100)
    End If

    Return ConvertBelowHundred(number)

End Function


Private Function ConvertBelowHundred(ByVal number As Long) As String

    Select Case number

        Case 0
            Return ""

        Case 1
            Return "One"

        Case 2
            Return "Two"

        Case 3
            Return "Three"

        Case 4
            Return "Four"

        Case 5
            Return "Five"

        Case 6
            Return "Six"

        Case 7
            Return "Seven"

        Case 8
            Return "Eight"

        Case 9
            Return "Nine"

        Case 10
            Return "Ten"

        Case 11
            Return "Eleven"

        Case 12
            Return "Twelve"

        Case 13
            Return "Thirteen"

        Case 14
            Return "Fourteen"

        Case 15
            Return "Fifteen"

        Case 16
            Return "Sixteen"

        Case 17
            Return "Seventeen"

        Case 18
            Return "Eighteen"

        Case 19
            Return "Nineteen"

        Case 20
            Return "Twenty"

        Case 30
            Return "Thirty"

        Case 40
            Return "Forty"

        Case 50
            Return "Fifty"

        Case 60
            Return "Sixty"

        Case 70
            Return "Seventy"

        Case 80
            Return "Eighty"

        Case 90
            Return "Ninety"

        Case Else

            Dim tens As Long = (number \ 10) * 10
            Dim units As Long = number Mod 10

            Return ConvertBelowHundred(tens) &amp; " " &amp; ConvertBelowHundred(units)

    End Select

End Function</Code>
